@model IEnumerable<ForFreePalestine.Models.HistoryInfo>

@{
    ViewData["Title"] = "History";
}

<div class="container mt-5">
    <h1 class="text-center mb-5" style="font-weight: 300; letter-spacing: 2px;">History of Palestine</h1>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="row g-0 align-items-center">
                        <div class="col-md-3 p-3 text-center">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/Image/history/@item.Image"
                                     class="img-fluid rounded shadow-sm"
                                     alt="@item.Title"
                                     style="max-height: 180px; cursor: pointer;"
                                     onclick="showDetails('@item.Title.Replace("'", "\\'")',
                                                                 '@Html.Raw(item.Description?.Replace("'", "\\'").Replace("\r\n", " ").Replace("\n", " "))',
                                                                 '/Image/history/@item.Image',
                                                                 '@item.EventDate.ToShortDateString()',
                                                                 '@item.Url')">
                            }
                        </div>
                        <div class="col-md-9">
                            <div class="card-body">
                                <h5 class="card-title fw-bold">@item.Title</h5>
                                <div class="card-text text-muted">
                                    @if (item.Description != null && item.Description.Length > 500)
                                    {
                                        @item.Description.Substring(0, 500)
                                
                                        <span>...</span>
                                    }
                                    else
                                    {
                                        @item.Description
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted">Tarih: @item.EventDate.ToShortDateString()</small>

                                    <div class="btn-group">
                                        <button class="btn btn-outline-primary btn-sm"
                                                onclick="showDetails('@item.Title.Replace("'", "\\'")',
                                                                         '@Html.Raw(item.Description?.Replace("'", "\\'").Replace("\r\n", " ").Replace("\n", " "))',
                                                                         '/Image/history/@item.Image',
                                                                         '@item.EventDate.ToShortDateString()',
                                                                         '@item.Url')">
                                            Devamını Oku
                                        </button>

                                        @* YÖNETİCİ BUTONLARI: Sadece Chef veya SuperUser görebilir *@
                                        @if (User.Identity.IsAuthenticated && (User.IsInRole("SuperUser") || User.IsInRole("Chef")))
                                        {
                                            <a asp-action="HistoryEdit" asp-route-id="@item.HistoryId" class="btn btn-outline-warning btn-sm mx-1">
                                                Düzenle
                                            </a>

                                            <form asp-action="HistoryDelete" asp-route-id="@item.HistoryId" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Kanka bak emin misin? Bu tarih kalıcı olarak silinecek!')">
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="historyModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid rounded mb-4 shadow" style="max-height: 400px; width: auto; max-width: 100%;" alt="">

                <div id="modalDescription" class="text-start px-3" style="line-height: 1.6; white-space: pre-line; margin-bottom: 20px;">
                </div>

                <div id="urlContainer" class="mt-4 text-start px-3 border-top pt-3" style="display:none;">
                    <span class="text-muted small d-block mb-2 fw-bold text-uppercase">Kaynaklar / Daha Fazla Bilgi:</span>
                    <div id="modalUrlList"></div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <small id="modalDate" class="text-muted me-auto"></small>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showDetails(title, desc, imgSrc, date, url) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalDescription').innerHTML = desc;
            document.getElementById('modalImage').src = imgSrc;
            document.getElementById('modalDate').innerText = "Olay Tarihi: " + date;

            var urlContainer = document.getElementById('urlContainer');
            var urlList = document.getElementById('modalUrlList');
            urlList.innerHTML = '';

            if (url && url !== '' && url !== 'null' && url !== 'undefined') {
                var links = url.split(',');
                var hasValidLink = false;

                links.forEach((link, index) => {
                    var trimmedLink = link.trim();
                    if(trimmedLink !== '') {
                        hasValidLink = true;
                        var a = document.createElement('a');
                        a.href = trimmedLink;
                        a.target = "_blank";
                        a.className = "d-block text-primary text-decoration-none fw-bold mb-2 small";
                        a.innerHTML = "🔗 Kaynak " + (index + 1) + " <span class='text-muted' style='font-weight:normal;'>(" + trimmedLink.substring(0, 30) + "...)</span>";
                        urlList.appendChild(a);
                    }
                });
                urlContainer.style.display = hasValidLink ? "block" : "none";
            } else {
                urlContainer.style.display = "none";
            }

            var myModal = new bootstrap.Modal(document.getElementById('historyModal'));
            myModal.show();
        }
    </script>
}