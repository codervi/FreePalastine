@model ForFreePalestine.Models.ForumThread


<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-lg">

                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-pencil-square"></i> Yeni Konu Aç</h3>
                </div>

                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="CategoryId" class="form-label fw-bold">Kategori Seçin <span class="text-danger">*</span></label>

                            <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.Categories">
                                <option value="">-- Lütfen bir kategori seçin --</option>
                            </select>

                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Title" class="form-label fw-bold">Konu Başlığı <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Konunun ana fikrini özetleyen bir başlık girin..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Content" class="form-label fw-bold">Mesajınız <span class="text-danger">*</span></label>
                            <textarea asp-for="Content" class="form-control" rows="8" placeholder="Düşüncelerinizi, haberleri veya belgeleri buraya yazın..."></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 me-md-2 fw-bold">
                                <i class="bi bi-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success btn-lg px-5 fw-bold shadow-sm">
                                <i class="bi bi-send-fill"></i> Konuyu Aç
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}